{
  "pluginId": "mobile",
  "methods": {
    "mute_list": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    },
    "notify": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "kind": {
            "type": "string",
            "enum": [
              "turn-finished",
              "thread-error",
              "pending-interaction",
              "needs-you"
            ]
          },
          "threadId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "const": "BB_LOOP"
          },
          "loopId": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "done",
                "snooze",
                "got_it",
                "drop",
                "choose",
                "hand_off",
                "nudge"
              ]
            }
          },
          "loopKind": {
            "type": "string",
            "enum": [
              "do",
              "decide",
              "read",
              "waiting"
            ]
          },
          "options": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "coalesceKey": {
            "type": "string",
            "maxLength": 300
          },
          "botId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "workerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "interactionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title",
          "body",
          "kind",
          "threadId",
          "projectId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "sent": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "sent"
        ],
        "additionalProperties": false
      }
    },
    "live_activity_register": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{8,64}$"
          },
          "botId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "push-to-start",
              "update"
            ]
          },
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64,200}$"
          }
        },
        "required": [
          "deviceId",
          "botId",
          "kind",
          "token"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "live_activity_unregister": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{8,64}$"
          },
          "botId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "push-to-start",
              "update"
            ]
          }
        },
        "required": [
          "deviceId"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "removed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "removed"
        ],
        "additionalProperties": false
      }
    },
    "live_activity_push": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "start"
              },
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "attributesType": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
              },
              "attributes": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "contentState": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "alert": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "title",
                  "body"
                ]
              },
              "staleDate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "event",
              "botId",
              "attributesType",
              "attributes",
              "contentState"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "update"
              },
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "contentState": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "alert": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "title",
                  "body"
                ]
              },
              "staleDate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "event",
              "botId",
              "contentState"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "const": "end"
              },
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "contentState": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "dismissalDate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "event",
              "botId",
              "contentState"
            ],
            "additionalProperties": false
          }
        ],
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          },
          "__schema1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema1"
                }
              }
            ]
          }
        }
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "removed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sent",
          "removed"
        ],
        "additionalProperties": false
      }
    },
    "push_status": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "devices": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastDelivery": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "number"
                  },
                  "sent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "at",
                  "sent"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ready",
          "problem",
          "devices",
          "lastDelivery"
        ],
        "additionalProperties": false
      }
    },
    "push_test": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "sent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "sent",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "mute_set": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "pattern": "^thr_[A-Za-z0-9]+$"
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "threadId",
          "muted"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    }
  }
}

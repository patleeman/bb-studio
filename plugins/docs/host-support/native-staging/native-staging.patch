+import { describe, it, expect, vi } from "vitest";
+import { readFile } from "node:fs/promises";
+import { build } from "esbuild";
+import { resolve } from "node:path";
+import { createDesktopUpdateRuntime } from "../src/desktop-update-runtime-staging.js";
+
+const packageRoot = process.cwd();
+describe("native staging build safety", () => {
+  it("never touches updater dependencies, checks, installs, timers, or supplied release feeds", async () => {
+    const dependencies = new Proxy(
+      {},
+      {
+        get() {
+          throw new Error("Staging accessed update dependency");
+        },
+      },
+    );
+    const runtime = createDesktopUpdateRuntime({
+      canReplaceAppImage: () => {
+        throw new Error("filesystem update probe");
+      },
+      channel: "latest",
+      currentVersion: "0.45.0",
+      env: { BB_DESKTOP_AUTO_UPDATE: "1", BB_DESKTOP_VERSION_CHECK: "1" },
+      feedUrl: "https://example.invalid/do-not-fetch",
+      isPackaged: true,
+      logger: dependencies as never,
+      platform: "macos",
+    });
+    const timer = vi.spyOn(globalThis, "setInterval");
+    const fetch = vi.spyOn(globalThis, "fetch");
+    for (const service of [runtime.versionService, runtime.autoService]) {
+      service.start();
+      expect(await service.checkAfterActive()).toBe(null);
+      expect((await service.checkForUpdates()).lastCheckedAt).toBe(null);
+      expect(service.getInfo().updateDownloaded).toBe(false);
+      service.subscribe(() => {
+        throw new Error("disabled service emitted");
+      })();
+      service.stop();
+    }
+    runtime.autoService.installUpdate();
+    expect(runtime.support).toEqual({ autoUpdate: false, versionCheck: false });
+    expect(timer).not.toHaveBeenCalled();
+    expect(fetch).not.toHaveBeenCalled();
+    vi.restoreAllMocks();
+  });
+  it("uses a distinct package identity and has no publishing feed", async () => {
+    const { resolveElectronBuilderConfig } = await import(
+      resolve(packageRoot, "scripts/run-electron-builder.mjs")
+    );
+    const base = JSON.parse(
+      await readFile(
+        resolve(packageRoot, "electron-builder.config.json"),
+        "utf8",
+      ),
+    );
+    const stage = resolveElectronBuilderConfig(
+      base,
+      { BB_DESKTOP_STAGING: "1", CSC_IDENTITY_AUTO_DISCOVERY: "false" },
+      ["--mac", "--dir", "--publish", "never"],
+    ).config;
+    expect(stage.appId).toBe("dev.bb.qa.native-staging");
+    expect(stage.productName).toBe("bb Native Staging");
+    expect(stage.extraMetadata.name).toBe("bb-native-staging");
+    expect(stage.publish).toBe(null);
+    expect(stage.directories.output).toBe("release-staging");
+    expect(() =>
+      resolveElectronBuilderConfig(base, { BB_DESKTOP_STAGING: "1" }, [
+        "--publish",
+        "always",
+      ]),
+    ).toThrow("cannot publish");
+    const normal = resolveElectronBuilderConfig(
+      base,
+      { CSC_IDENTITY_AUTO_DISCOVERY: "false" },
+      [],
+    ).config;
+    expect(normal.appId).toBe("dev.bb.desktop");
+    expect(normal.publish![0].url).toContain("desktop-latest/");
+  });
+  it("bundles the staging runtime without any updater or release feed implementation", async () => {
+    const result = await build({
+      entryPoints: [
+        resolve(packageRoot, "src/desktop-update-runtime-staging.ts"),
+      ],
+      bundle: true,
+      platform: "node",
+      write: false,
+      metafile: true,
+    });
+    expect(Object.keys(result.metafile!.inputs)).toEqual([
+      "src/desktop-update-runtime-staging.ts",
+    ]);
+    expect(result.outputFiles![0].text).not.toMatch(
+      /electron-updater|quitAndInstall|desktop-latest|desktop-nightly/,
+    );
+  });
+});

diff --git a/apps/desktop/scripts/desktop-staging.mjs b/apps/desktop/scripts/desktop-staging.mjs
new file mode 100644
index 000000000..f9036a918
--- /dev/null
+++ b/apps/desktop/scripts/desktop-staging.mjs
@@ -0,0 +1,41 @@
+export function isDesktopStaging(env) {
+  const value = env.BB_DESKTOP_STAGING;
+  if (value === undefined || value === "0") return false;
+  if (value === "1") return true;
+  throw new Error("BB_DESKTOP_STAGING must be 0 or 1");
+}
+export const STAGING_IDENTITY = {
+  appId: "dev.bb.qa.native-staging",
+  productName: "bb Native Staging",
+  name: "bb-native-staging",
+};
+export function applyDesktopStagingConfig(config, args) {
+  const publishIndex = args.findIndex(
+    (arg) => arg === "--publish" || arg === "-p",
+  );
+  if (
+    (publishIndex !== -1 && args[publishIndex + 1] !== "never") ||
+    args.some(
+      (arg) => arg.startsWith("--publish=") && arg !== "--publish=never",
+    )
+  ) {
+    throw new Error("Staging packages cannot publish");
+  }
+  const result = structuredClone(config);
+  Object.assign(result, {
+    appId: STAGING_IDENTITY.appId,
+    productName: STAGING_IDENTITY.productName,
+  });
+  result.extraMetadata = {
+    ...result.extraMetadata,
+    name: STAGING_IDENTITY.name,
+    bbDesktopStaging: true,
+  };
+  result.artifactName = "bb-native-staging-${version}-${arch}.${ext}";
+  result.publish = null;
+  result.generateUpdatesFilesForAllChannels = false;
+  result.directories.output = "release-staging";
+  result.linux.executableName = STAGING_IDENTITY.name;
+  result.mac.notarize = false;
+  return result;
+}

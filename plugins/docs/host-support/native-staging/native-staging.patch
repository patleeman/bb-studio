+export function createDesktopUpdateRuntime(args: DesktopUpdateRuntimeArgs) {
+  const {
+    canReplaceAppImage,
+    channel,
+    currentVersion: desktopVersion,
+    env,
+    feedUrl: desktopUpdateFeedUrl,
+    isPackaged,
+    logger,
+    platform: desktopPlatform,
+  } = args;
+  const desktopUpdateSupport = resolveDesktopUpdateSupport({
+    canReplaceAppImage,
+    env,
+    platform: desktopPlatform,
+  });
+  const desktopUpdateService = createDesktopUpdateService({
+    channel: channel,
+    currentVersion: desktopVersion,
+    enabled:
+      desktopUpdateSupport.versionCheck &&
+      (isPackaged || env.BB_DESKTOP_VERSION_CHECK === "1"),
+    feedUrl: desktopUpdateFeedUrl,
+    logger: logger,
+    platform: desktopPlatform,
+  });
+  const desktopAutoUpdateService = createDesktopAutoUpdateService({
+    currentVersion: desktopVersion,
+    enabled:
+      desktopUpdateSupport.autoUpdate &&
+      shouldEnableDesktopAutoUpdate({
+        env,
+        isPackaged: isPackaged,
+      }),
+    forceDevUpdateConfig: !isPackaged && env.BB_DESKTOP_AUTO_UPDATE === "1",
+    logger: logger,
+    platform: desktopPlatform,
+    updater: createElectronAutoUpdaterAdapter(autoUpdater),
+  });
+  return {
+    support: desktopUpdateSupport,
+    versionService: desktopUpdateService,
+    autoService: desktopAutoUpdateService,
+  };
+}

+import type { BbDesktopInfo } from "@bb/desktop-contract";
+import type {
+  DesktopUpdateRuntime,
+  DesktopUpdateRuntimeArgs,
+} from "./desktop-update-runtime-types.js";
+
+export function createDesktopUpdateRuntime(
+  args: DesktopUpdateRuntimeArgs,
+): DesktopUpdateRuntime {
+  const info: BbDesktopInfo = {
+    downloadState: "idle",
+    lastCheckedAt: null,
+    latestVersion: null,
+    pendingVersion: null,
+    platform: args.platform,
+    updateAvailable: false,
+    updateDownloaded: false,
+    version: args.currentVersion,
+  };
+  const service = {
+    async checkAfterActive() {
+      return null;
+    },
+    async checkForUpdates() {
+      return info;
+    },
+    getInfo() {
+      return info;
+    },
+    start() {},
+    stop() {},
+    subscribe() {
+      return () => {};
+    },
+    installUpdate() {},
+  };
+  return {
+    support: { autoUpdate: false, versionCheck: false },
+    versionService: service,
+    autoService: service,
+  };
+}

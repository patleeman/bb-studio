{
  "name": "studio-applets",
  "productName": "Studio Applets",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Experimental. Runs Studio Applets: small native macOS apps your agents write as plain folders.",
  "author": "Patrick Lee",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "node scripts/build.mjs && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-studio-applets} electron-builder --mac --publish never",
    "dist:unsigned": "node scripts/build.mjs && electron-builder --mac --publish never -c.mac.identity=null -c.mac.notarize=false"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/browser": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "htm": "3.1.1",
    "lucide-react": "^1.55.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.1",
    "zod": "^4.3.6"
  },
  "build": {
    "appId": "nyc.plee.studio-applets",
    "productName": "Studio Applets",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "patrick lee (3753DAN98U)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.7.0": true
  }
}

{
  "id": "hud",
  "name": "Thread HUD",
  "version": "0.2.0",
  "api": 1,
  "entry": "index.html",
  "description": "One thread floating above your work: its live conversation and a composer. Alt+Shift+Space brings it to your pointer.",
  "windows": {
    "main": { "kind": "overlay", "width": 400, "height": 520, "position": "top-right", "resizable": true }
  },
  "capabilities": ["window.overlay", "shortcut.global", "notify", "bb.threads.read", "bb.threads.tell", "bb.open"],
  "shortcuts": { "summon": "Alt+Shift+Space" }
}

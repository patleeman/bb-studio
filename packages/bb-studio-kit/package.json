{
  "name": "@bb-studio/kit",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Shared contract and UI for BB Studio plugins. Bundled into each Studio plugin; not a plugin itself.",
  "exports": {
    "./contract": "./src/contract.ts",
    "./decisions-contract": "./src/decisions-contract.ts",
    "./decisions": "./src/decisions.ts",
    "./server": "./src/server/index.ts",
    "./ids": "./src/ids.ts",
    "./cli": "./src/cli.ts",
    "./format": "./src/format.ts",
    "./page-checkbox": "./src/page-checkbox.ts",
    "./tables": "./src/tables/index.ts",
    "./table-grid": "./src/tables/grid/index.ts",
    "./app": "./src/app/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/huge-icon": "./src/ui/huge-icon.tsx"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "bb": {
    "pluginTailwindContent": [
      "src/**/*.{ts,tsx}"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "29.0.1",
    "react": "19.2.4",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

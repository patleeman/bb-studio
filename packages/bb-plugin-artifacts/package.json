{
  "name": "bb-plugin-artifacts",
  "version": "0.1.0",
  "type": "module",
  "description": "Part of BB Studio. Keep the images, pages, reports and files your agents make, in Studio's collection.",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Studio Artifacts",
    "description": "Part of BB Studio. Keep the images, pages, reports and files your agents make, in Studio's collection.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "artifact": "./assets/icon.svg",
        "image": "./assets/icon-image.svg",
        "save": "./assets/icon-save.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@bb-studio/kit": "file:../studio-kit",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "sonner": "^2.0.7",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

{
  "name": "@bb-studio/pages",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Studio Pages",

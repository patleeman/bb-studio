{
  "name": "@bb-studio/artifacts",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Part of BB Studio. Keep the images, pages, reports and files your agents make, in Studio's collection.",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Studio Artifacts",
    "description": "Part of BB Studio. Keep the images, pages, reports and files your agents make, in Studio's collection.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "artifact": "./assets/icon.svg",
        "image": "./assets/icon-image.svg",
        "save": "./assets/icon-save.svg",
        "audio": "./assets/icon-audio.svg",
        "video": "./assets/icon-video.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@bb-studio/kit": "file:../bb-studio-kit.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.11.9",
    "jsdom": "29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.11.9",
    "jsdom": "29.0.1",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }

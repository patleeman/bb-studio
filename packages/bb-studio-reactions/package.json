    "build": "bb plugin build .",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@bb-studio/kit": "file:../bb-studio-kit.tgz"
  },
  "devDependencies": {

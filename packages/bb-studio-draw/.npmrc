# Excalidraw 0.18 depends on Radix 1.0 packages whose React peer stops at 18,
# while the plugin SDK peers on React 19. The host provides React at runtime,
# so the peer ranges never meet; skip checking them.
legacy-peer-deps=true

# Copy @bb-studio/kit into node_modules instead of symlinking it, so the
# kit's own imports resolve against this plugin's dependencies when BB
# installs the package on its own.
install-links=true

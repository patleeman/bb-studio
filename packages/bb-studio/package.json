{
  "name": "@bb-studio/studio",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "tailwind:blocknote": "node scripts/blocknote-tailwind.mjs",
    "css:blocknote": "node scripts/blocknote-css.mjs"
  },
  "bb": {
    "name": "Studio",
    "description": "The home of BB Studio, with pages, recordings, drawings, designs, dashboards and artifacts built in: one collection with search, tags, project leads, item conversations, quotes and emoji reactions on replies.",
    "branding": {
      "icon": "./icons/studio.svg",
      "experimental_icons": {
        "studio": "./icons/studio.svg",
        "tag": "./icons/tag.svg",
        "hash": "./icons/hash.svg",
        "link": "./icons/link.svg",
        "bookmark": "./icons/bookmark.svg",
        "artifact": "./icons/artifact.svg",
        "artifact-image": "./icons/artifact-image.svg",
        "artifact-save": "./icons/artifact-save.svg",
        "artifact-audio": "./icons/artifact-audio.svg",
        "artifact-video": "./icons/artifact-video.svg",
        "draw": "./icons/draw.svg",
        "design": "./icons/design.svg",
        "talk": "./icons/talk.svg",
        "pages": "./icons/pages.svg",
        "explore": "./icons/explore.svg",
        "dashboard": "./icons/dashboard.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "themes": [
      {
        "id": "bb-studio",
        "name": "BB Studio",
        "description": "The Silk S icon's colors: teal-black ground, a warm coral accent. Light and dark.",
        "css": "./themes/bb-studio.css"
      }
    ]
  },
  "dependencies": {
    "@bb-studio/kit": "file:../bb-studio-kit.tgz",
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@tiptap/pm": "3.31.3",
    "lib0": "0.2.119",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.16.1",
    "micromark-extension-gfm": "^3.0.0",
    "pdf-lib": "1.17.1",
    "react-grid-layout": "2.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "shiki": "4.4.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

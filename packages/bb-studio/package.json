{
  "name": "@bb-studio/studio",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "bb": {
    "name": "Studio",
    "description": "The home of BB Studio. One collection for your pages, recordings, drawings, tasks and bots: search, group with tags, filter by project, and hand anything to an agent. Add-ons plug in.",
    "branding": {
      "icon": "./icons/studio.svg",
      "experimental_icons": {
        "studio": "./icons/studio.svg",
        "tag": "./icons/tag.svg",
        "hash": "./icons/hash.svg",
        "link": "./icons/link.svg",
        "bookmark": "./icons/bookmark.svg",
        "feed": "./src/modules/feed/icons/feed.svg",
        "mark-read": "./src/modules/feed/icons/mark-read.svg",
        "task": "./src/modules/tasks/assets/icon.svg",
        "board": "./src/modules/tasks/assets/icon-board.svg",
        "flag": "./src/modules/tasks/assets/icon-flag.svg",
        "artifact": "./src/modules/artifacts/assets/icon.svg",
        "image": "./src/modules/artifacts/assets/icon-image.svg",
        "save": "./src/modules/artifacts/assets/icon-save.svg",
        "talk": "./src/modules/talk/icons/talk.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "themes": [
      {
        "id": "bb-studio",
        "name": "BB Studio",
        "description": "The Silk S icon's colors: teal-black ground, a warm coral accent. Light and dark.",
        "css": "./themes/bb-studio.css"
      }
    ]
  },
  "dependencies": {
    "@bb-studio/kit": "file:../bb-studio-kit.tgz",
    "zod": "^4.3.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "mdast-util-from-markdown": "^2.0.3",
    "@radix-ui/react-checkbox": "^1.3.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@types/mdast": "4.0.4",
    "tsx": "^4.20.0",
    "vaul": "^1.1.2",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9"
  }
}

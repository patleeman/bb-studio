{
  "name": "bb-plugin-studio-chat",
  "version": "0.1.0",
  "type": "module",
  "description": "Part of BB Studio. A chat that floats over your pages, drawings and other Studio items, knows which one you're looking at, and can hold any thread.",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Studio Chat",
    "description": "Part of BB Studio. A chat that floats over your pages, drawings and other Studio items, knows which one you're looking at, and can hold any thread.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@bb-studio/kit": "file:../studio-kit",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

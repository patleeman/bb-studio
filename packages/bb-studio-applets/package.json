{
  "name": "@bb-studio/applets",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "bb": {
    "name": "Studio Applets",
    "description": "Part of BB Studio. Experimental. Small native macOS apps your agents write as plain folders, such as a HUD of running threads, run by one signed Studio Applets app. Applets reach the desktop and BB only through an API you approve.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}

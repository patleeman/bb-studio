{
  "appId": "nyc.plee.bbstudio",
  "productName": "BB Studio",
  "artifactName": "BB-Studio-${version}-${arch}.${ext}",
  "extraMetadata": { "name": "bb-studio-desktop" },
  "toolsets": {
    "appimage": "1.0.3"
  },
  "afterPack": "scripts/prepare-native-modules.cjs",
  "asar": true,
  "asarUnpack": ["dist/bb-app-bridge.mjs", "node_modules/**"],
  "directories": {
    "buildResources": "assets",
    "output": "release"
  },
  "files": [
    "assets/**",
    "dist/**",
    "node_modules/**",
    {
      "from": "node_modules/bb-app/server/dist/app-scaffold-template",
      "to": "node_modules/bb-app/server/dist/app-scaffold-template",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/bb-app/node_modules/npm/node_modules",
      "to": "node_modules/npm/node_modules",
      "filter": ["**/*"]
    },
    "package.json",
    "!**/*.map"
  ],
  "publish": [
    {
      "channel": "latest",
      "provider": "generic",
      "url": "https://updates.invalid/bb-studio/desktop-latest/"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSAppleEventsUsageDescription": "BB Studio lets agents you run control other apps on this Mac, such as Computer Use.",
      "NSMicrophoneUsageDescription": "BB Studio uses your microphone for voice input and sites you allow in the in-app browser."
    },
    "minimumSystemVersion": "13.0.0",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "icon": "assets/icon.icns",
    "identity": null,
    "notarize": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ]
  },
  "linux": {
    "category": "Development",
    "executableName": "bb",
    "icon": "assets/icon.png",
    "target": [{ "target": "AppImage", "arch": ["x64"] }]
  },
  "win": {
    "icon": "assets/icon.png",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false
  },
  "dmg": {
    "sign": false
  },
  "npmRebuild": false
}

{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "Studio for BB: pages, voice recordings, drawings, artifacts, tasks, bot teams and a sidebar, in one collection your agents can use.",
  "plugins": [
    {
      "id": "studio",
      "displayName": "Studio",
      "description": "The home of BB Studio. One collection for your pages, recordings, drawings, tasks and bots: search, group with tags, filter by project, and hand anything to an agent. Add-ons plug in.",
      "icon": {
        "url": "./packages/bb-studio/icons/studio.svg"
      },
      "tags": [
        "productivity",
        "documents",
        "collaboration",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio",
          "ref": "main"
        }
      }
    },
    {
      "id": "studio-chat",
      "displayName": "Studio Chat",
      "description": "Part of BB Studio. One Chat action on Studio items opens their linked conversation or a new composer. Choose or start another conversation from its menu; item quotes keep their own context across main and Float views.",
      "icon": {
        "url": "./packages/bb-studio-chat/assets/icon.svg"
      },
      "tags": [
        "productivity",
        "collaboration",
        "agents",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio-chat",
          "ref": "main"
        }
      }
    },
    {
      "id": "float",
      "displayName": "Float",
      "description": "Part of BB Studio. Float any thread, channel, Studio item or view as a tab in one panel, docked at the bottom or dragged anywhere, and keep several open while you work.",
      "icon": {
        "url": "./packages/bb-studio-float/assets/icon.svg"
      },
      "tags": [
        "productivity",
        "collaboration",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },

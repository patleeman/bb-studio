{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "Your office in BB: organize work in Spaces, delegate to bots, and follow requests and reports in one Inbox.",

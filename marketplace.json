{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "BB Studio: the Studio plugin, with pages, whiteboards, recordings, designs, apps and Code built in, plus Mobile for iOS notifications.",
  "plugins": [
    {
      "id": "studio",
      "displayName": "Studio",
      "description": "The home of BB Studio: pages, whiteboards, recordings, designs and apps in one library, with Bots, Todos, Smart Queue and VS Code on each thread.",
      "icon": {
        "url": "./plugins/packages/bb-studio/icons/studio.svg"
      },
      "tags": [
        "documents",
        "drawing",
        "design",
        "voice",
        "dictation",
        "files",
        "collaboration",
        "bb-studio",
        "decisions",
        "smart-queue"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "plugins/packages/bb-studio",
          "ref": "stable"
        }
      }
    },
    {
      "id": "mobile",
      "displayName": "Studio Mobile",
      "description": "Part of BB Studio. The server side of the BB Studio iOS app: push notifications with lock-screen actions and muted threads.",
      "icon": "Smartphone",
      "tags": [
        "mobile",
        "notifications",
        "ios",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "plugins/packages/bb-studio-mobile",
          "ref": "stable"
        }
      }
    },
    {
      "id": "studio-visual-chat",
      "displayName": "BB Studio Visual Chat",
      "description": "Part of BB Studio (prototype). Visual Chat: talk with an agent that answers on a board it designs each turn, with pictures, charts and numbers that animate as they change. Off unless you install it.",
      "icon": "GridView",
      "tags": [
        "visual-chat",
        "canvas",
        "visualization",
        "charts",
        "voice",
        "prototype",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "plugins/packages/bb-studio-visual-chat",
          "ref": "stable"
        }
      }
    }
  ]
}

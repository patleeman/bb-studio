{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "BB Studio: one Studio plugin with pages, recordings, drawings, designs and artifacts built in, plus Code, Decisions and Mobile beside it.",
  "plugins": [
    {
      "id": "studio",
      "displayName": "Studio",
      "description": "The home of BB Studio, with pages, recordings, drawings, designs and artifacts built in: one collection with search, tags, project leads, item conversations, quotes and emoji reactions on replies.",
      "icon": {
        "url": "./packages/bb-studio/icons/studio.svg"
      },
      "tags": [
        "productivity",
        "documents",
        "drawing",
        "design",
        "voice",
        "dictation",
        "files",
        "collaboration",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio",
          "ref": "stable"
        }
      }
    },
    {
      "id": "mobile",
      "displayName": "Studio Mobile",
      "description": "Part of BB Studio. The server side of the BB Studio iOS app: push notifications with lock-screen actions and muted threads.",
      "icon": "Smartphone",
      "tags": [
        "mobile",
        "notifications",
        "ios",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio-mobile",
          "ref": "stable"
        }
      }
    },
    {
      "id": "smart-decisions",
      "displayName": "Studio Decisions",
      "description": "Part of BB Studio. One place to set up the fast Jev model that makes quick decisions. It runs Smart Queue, which steers or queues a message you send to a busy thread, and other plugins can ask it for quick decisions.",
      "icon": {
        "url": "./packages/bb-studio-decisions/assets/icon.svg"
      },
      "tags": [
        "threads",
        "automation",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio-decisions",
          "ref": "stable"
        }
      }
    },
    {
      "id": "studio-code",
      "displayName": "Studio Code",
      "description": "Part of BB Studio. VS Code workspaces in your projects: open one or more folders in a full editor, run by a local code-server.",
      "icon": {
        "url": "./packages/bb-studio-code/assets/icon.svg"
      },
      "tags": [
        "productivity",
        "developer-tools",
        "editor",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio-code",
          "ref": "stable"
        }
      }
    },
    {
      "id": "external-agents",
      "displayName": "Studio Agents",
      "description": "Part of BB Studio. External agent providers for Studio bots: Hermes, OpenClaw and Grok, plus experimental ChatGPT Dot.",
      "icon": "Cloud",
      "tags": [
        "agents",
        "providers",
        "bots",
        "bb-studio"
      ],
      "author": {
        "name": "Patrick Lee",
        "github": "patleeman"
      },
      "source": {
        "git": {
          "url": "https://github.com/patleeman/bb-studio.git",
          "subdir": "packages/bb-studio-agents",
          "ref": "stable"
        }
      }
    }
  ]
}

  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "BB Studio: one Studio plugin with pages, recordings, drawings, designs, dashboards, artifacts and Decisions built in, plus Code and Mobile beside it. Includes the Decisions upgrade bridge.",

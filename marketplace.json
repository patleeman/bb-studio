{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "bb-studio",
  "displayName": "BB Studio",
  "description": "Studio for BB: pages, voice recordings, drawings, artifacts, tables and a sidebar, in one collection your agents can use.",

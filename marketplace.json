          "subdir": "packages/bb-studio",
          "ref": "stable"
        }
      }
    },
    {
      "id": "pages",
      "displayName": "Studio Pages",
      "description": "Part of BB Studio. Collaborative pages you write with your agents, with live editing, comments, version history and ordinary agent chats.",

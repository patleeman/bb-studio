+// @vitest-environment jsdom
+import { useContext, useState } from "react";
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+} from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  CompanionComposerContext,
+  RetainThreadComposer,
+  ThreadComposerRetentionProvider,
+} from "./thread-composer-retention";
+import { ThreadProviderContext } from "@/components/thread/thread-provider-context";
+
+afterEach(cleanup);
+
+function Editor({ submit }: { submit: () => void }) {
+  const [draft, setDraft] = useState("");
+  const provider = useContext(ThreadProviderContext);
+  return (
+    <div>
+      <textarea
+        aria-label="Draft"
+        value={draft}
+        onChange={(event) => setDraft(event.target.value)}
+      />
+      <input type="file" aria-label="File" />
+      <button onClick={submit}>Send with {provider.providerId}</button>
+    </div>
+  );
+}
+
+describe("original main-thread composer adoption", () => {
+  it("moves the original editor and file input, changes callbacks/context, and returns it after closing the companion", () => {
+    const mainSubmit = vi.fn();
+    const companionSubmit = vi.fn();
+    const show = vi.fn();
+    const experience = (companion: boolean, main = true) => (
+      <ThreadComposerRetentionProvider>
+        {main ? (
+          <div data-testid="main">
+            <ThreadProviderContext.Provider
+              value={{ providerId: "main-provider", pluginId: null }}
+            >
+              <RetainThreadComposer threadId="one" main>
+                <Editor submit={mainSubmit} />
+              </RetainThreadComposer>
+            </ThreadProviderContext.Provider>
+          </div>
+        ) : null}
+        {companion ? (
+          <div data-testid="companion">
+            <CompanionComposerContext.Provider value={{ show }}>
+              <ThreadProviderContext.Provider
+                value={{ providerId: "companion-provider", pluginId: null }}
+              >
+                <RetainThreadComposer threadId="one">
+                  <Editor submit={companionSubmit} />
+                </RetainThreadComposer>
+              </ThreadProviderContext.Provider>
+            </CompanionComposerContext.Provider>
+          </div>
+        ) : null}
+      </ThreadComposerRetentionProvider>
+    );
+    const view = render(experience(false));
+    const editor = screen.getByRole("textbox");
+    const input = screen.getByLabelText("File");
+    fireEvent.change(editor, { target: { value: "Keep this exact draft" } });
+    editor.focus();
+    view.rerender(experience(true));
+    expect(screen.getAllByRole("textbox")).toEqual([editor]);
+    expect(screen.getByLabelText("File")).toBe(input);
+    expect(screen.getByTestId("companion").contains(editor)).toBe(true);
+    expect(document.activeElement).toBe(editor);
+    fireEvent.click(screen.getByText("Show companion"));
+    expect(show).toHaveBeenCalledOnce();
+    fireEvent.click(screen.getByText("Send with companion-provider"));
+    expect(companionSubmit).toHaveBeenCalledOnce();
+    expect(mainSubmit).not.toHaveBeenCalled();
+    view.rerender(experience(true, false));
+    expect(screen.getByRole("textbox")).toBe(editor);
+    view.rerender(experience(true));
+    expect(screen.getAllByRole("textbox")).toEqual([editor]);
+    view.rerender(experience(false));
+    expect(screen.getByRole("textbox")).toBe(editor);
+    expect(screen.getByTestId("main").contains(editor)).toBe(true);
+  });
+
+  it("returns the original owner to an available main anchor after the companion closes", () => {
+    const experience = (companion: boolean) => (
+      <ThreadComposerRetentionProvider>
+        <div data-testid="main">
+          <RetainThreadComposer threadId="one" main>
+            <Editor submit={() => {}} />
+          </RetainThreadComposer>
+        </div>
+        {companion ? (
+          <div>
+            <CompanionComposerContext.Provider value={{ show() {} }}>
+              <RetainThreadComposer threadId="one">
+                <Editor submit={() => {}} />
+              </RetainThreadComposer>
+            </CompanionComposerContext.Provider>
+          </div>
+        ) : null}
+      </ThreadComposerRetentionProvider>
+    );
+    const view = render(experience(false));
+    const editor = screen.getByRole("textbox");
+    fireEvent.change(editor, { target: { value: "Return me" } });
+    view.rerender(experience(true));
+    view.rerender(experience(false));
+    expect(screen.getByRole("textbox")).toBe(editor);
+    expect(screen.getByTestId("main").contains(editor)).toBe(true);
+    expect(editor instanceof HTMLTextAreaElement && editor.value).toBe(
+      "Return me",
+    );
+  });
+
+  it("adopts the recently focused main pane and leaves other main editors independent", () => {
+    const experience = (companion: boolean, threadId = "one") => (
+      <ThreadComposerRetentionProvider>
+        {["first", "second"].map((id) => (
+          <div key={id} data-testid={id}>
+            <RetainThreadComposer threadId={threadId} main>
+              <Editor submit={() => {}} />
+            </RetainThreadComposer>
+          </div>
+        ))}
+        {companion ? (
+          <div data-testid="companion">
+            <CompanionComposerContext.Provider value={{ show() {} }}>
+              <RetainThreadComposer threadId={threadId}>
+                <Editor submit={() => {}} />
+              </RetainThreadComposer>
+            </CompanionComposerContext.Provider>
+          </div>
+        ) : null}
+      </ThreadComposerRetentionProvider>
+    );
+    const view = render(experience(false));
+    const [first, second] = screen.getAllByRole("textbox");
+    fireEvent.change(first!, { target: { value: "First pane" } });
+    fireEvent.change(second!, { target: { value: "Second pane" } });
+    act(() => second!.focus());
+    view.rerender(experience(true));
+    expect(screen.getByTestId("companion").contains(second!)).toBe(true);
+    expect(screen.getByTestId("first").contains(first!)).toBe(true);
+    expect(screen.getAllByRole("textbox")).toHaveLength(2);
+    view.rerender(experience(false, "different"));
+    expect(screen.getAllByRole("textbox")).not.toContain(first);
+    expect(screen.getAllByRole("textbox")).not.toContain(second);
+  });
+  it("preserves a contenteditable selection while moving its original nodes", () => {
+    const experience = (companion: boolean) => (
+      <ThreadComposerRetentionProvider>
+        <RetainThreadComposer threadId="one" main>
+          <div contentEditable suppressContentEditableWarning role="textbox">
+            Original selected draft
+          </div>
+        </RetainThreadComposer>
+        {companion ? (
+          <CompanionComposerContext.Provider value={{ show() {} }}>
+            <RetainThreadComposer threadId="one">
+              <div
+                contentEditable
+                suppressContentEditableWarning
+                role="textbox"
+              >
+                Original selected draft
+              </div>
+            </RetainThreadComposer>
+          </CompanionComposerContext.Provider>
+        ) : null}
+      </ThreadComposerRetentionProvider>
+    );
+    const view = render(experience(false));
+    const editor = screen.getByRole("textbox");
+    const text = editor.firstChild!;
+    const range = document.createRange();
+    range.setStart(text, 9);
+    range.setEnd(text, 17);
+    const selection = window.getSelection()!;
+    selection.removeAllRanges();
+    selection.addRange(range);
+    view.rerender(experience(true));
+    expect(screen.getByRole("textbox")).toBe(editor);
+    expect(selection.toString()).toBe("selected");
+    expect(selection.anchorNode).toBe(text);
+    expect(selection.focusNode).toBe(text);
+    expect(selection.anchorOffset).toBe(9);
+    expect(selection.focusOffset).toBe(17);
+    selection.setBaseAndExtent(text, 17, text, 9);
+    view.rerender(experience(false));
+    expect(screen.getByRole("textbox")).toBe(editor);
+    expect(selection.toString()).toBe("selected");
+    expect(selection.anchorOffset).toBe(17);
+    expect(selection.focusOffset).toBe(9);
+  });
+});

+import { openPaneContentInSplit } from "./openPaneContentInSplit";
+import { reconcileLayoutForContent } from "@/views/thread-detail/splitThreadNavigation";
+
+describe("opening distinct plugin items in splits", () => {
+  it("keeps two companions from one panel and refocuses the exact existing item", () => {
+    const store = createStore();
+    const first = { kind: "plugin-panel", pluginId: "float", panelPath: "companions", subPath: "path:/plugins/pages/pages/first" } as const;
+    const second = { ...first, subPath: "path:/plugins/pages/pages/second" };
+    const navigate = vi.fn();
+    store.set(splitLayoutAtom, reconcileLayoutForContent(null, first));
+    const open = (content: typeof second) => openPaneContentInSplit({ store, navigate, content, route: `/plugins/float/companions/${encodeURIComponent(content.subPath)}`, enabled: true });
+    open(second);
+    const split = store.get(splitLayoutAtom)!;
+    expect(listPanes(split.root).map(pane => pane.content)).toEqual([first, second]);
+    const reconciled = reconcileLayoutForContent(split, second);
+    expect(listPanes(reconciled.root).map(pane => pane.content)).toEqual([first, second]);
+    store.set(splitLayoutAtom, reconciled);
+    open(first);
+    const refocused = store.get(splitLayoutAtom)!;
+    expect(listPanes(refocused.root)).toHaveLength(2);
+    expect(refocused.focusedPaneId).toBe(listPanes(refocused.root)[0]!.paneId);
+    expect(navigate).toHaveBeenLastCalledWith(`/plugins/float/companions/${encodeURIComponent(first.subPath)}`, { replace: true });
+  });
+
+  it("normal navigation replaces the focused item without overwriting another item in that panel", () => {
+    const first = { kind: "plugin-panel", pluginId: "pages", panelPath: "pages", subPath: "first" } as const;
+    const store = createStore();
+    const second = { ...first, subPath: "second" };
+    store.set(splitLayoutAtom, reconcileLayoutForContent(null, first));
+    openPaneContentInSplit({ store, navigate: vi.fn(), content: second, route: "/plugins/pages/pages/second", enabled: true });
+    const after = reconcileLayoutForContent(store.get(splitLayoutAtom)!, { ...first, subPath: "third" });
+    expect(listPanes(after.root).map(pane => pane.content)).toEqual([first, { ...first, subPath: "third" }]);
+    const back = reconcileLayoutForContent(after, first);
+    expect(listPanes(back.root).map(pane => pane.content)).toEqual([first, { ...first, subPath: "third" }]);
+    expect(back.focusedPaneId).toBe(listPanes(back.root)[0]!.paneId);
+  });
+});

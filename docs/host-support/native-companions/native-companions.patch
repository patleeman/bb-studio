+import { useCallback, useLayoutEffect, useRef } from "react";
+import { Icon } from "@bb/shared-ui/icon";
+import { Button } from "@bb/shared-ui/button";
+import type { ThreadSecondaryPanelProps } from "@/components/secondary-panel/ThreadSecondaryPanel";
+import type { SecondaryPanelRenderableTab } from "@/components/secondary-panel/secondaryPanelTab";
+import { useOptionalPaneContext } from "@/views/thread-detail/PaneContext";
+import { CompanionViewOutlet, useCompanionViews } from "./PluginCompanionView";
+import {
+  companionViewStore,
+  type CompanionViewEntry,
+} from "./companion-view-store";
+
+export function useCompanionPanelVisibility(
+  open: boolean,
+  onToggle: () => void,
+  onClose: () => void,
+  syncNative = true,
+) {
+  const pane = useOptionalPaneContext();
+  const state = useCompanionViews();
+  const ownsCompanions = pane === null || pane.isFocused;
+  const hasCompanions =
+    ownsCompanions &&
+    state.entries.some((entry) => entry.props.placement === "workbench");
+  const isOpen = open || (hasCompanions && state.visible);
+  const previous = useRef({ open, hasCompanions: false, focusRequest: 0 });
+  useLayoutEffect(() => {
+    const before = previous.current;
+    previous.current = {
+      open,
+      hasCompanions,
+      focusRequest: state.focusRequest,
+    };
+    if (!syncNative || !hasCompanions) return;
+    const requested =
+      state.visible &&
+      (!before.hasCompanions || before.focusRequest !== state.focusRequest);
+    if (requested && !open) onToggle();
+    else if (before.open && !open) companionViewStore.show(false);
+  }, [
+    hasCompanions,
+    onToggle,
+    open,
+    state.focusRequest,
+    state.visible,
+    syncNative,
+  ]);
+  const close = useCallback(() => {
+    if (ownsCompanions) companionViewStore.show(false);
+    onClose();
+  }, [onClose, ownsCompanions]);
+  const toggle = useCallback(() => {
+    if (isOpen) {
+      if (ownsCompanions) companionViewStore.show(false);
+      onClose();
+    } else {
+      if (hasCompanions) companionViewStore.show(true);
+      onToggle();
+    }
+  }, [hasCompanions, isOpen, onClose, onToggle, ownsCompanions]);
+  return hasCompanions
+    ? { open: isOpen, onClose: close, onToggle: toggle }
+    : { open, onClose, onToggle };
+}
+
+function CompanionPanelContent({ entry }: { entry: CompanionViewEntry }) {
+  const { props } = entry;
+  return (
+    <div className="flex h-full min-h-0 flex-col">
+      <div className="flex shrink-0 items-center gap-1 border-b border-border-seam px-2 py-1">
+        {props.onBack ? (
+          <Button
+            variant="ghost"
+            size="sm"
+            aria-label="Back"
+            onClick={() => entry.props.onBack?.()}
+          >
+            <Icon name="ChevronLeft" />
+          </Button>
+        ) : null}
+        {props.onPinnedChange ? (
+          <Button
+            variant="ghost"
+            size="sm"
+            aria-label={props.pinned ? "Unpin companion" : "Pin companion"}
+            onClick={() => entry.props.onPinnedChange?.(!entry.props.pinned)}
+          >
+            <Icon name={props.pinned ? "PinOff" : "Pin"} />
+          </Button>
+        ) : null}
+        <span className="flex-1" />
+        <Button
+          variant="ghost"
+          size="sm"
+          onClick={() => entry.props.onPlacementChange("floating")}
+        >
+          <Icon name="PictureInPicture2" /> Float
+        </Button>
+        <Button
+          variant="ghost"
+          size="sm"
+          onClick={() => entry.props.onPlacementChange("main")}
+        >
+          <Icon name="Maximize2" /> Main view
+        </Button>
+      </div>
+      <CompanionViewOutlet entry={entry} />
+    </div>
+  );
+}
+
+export function useCompanionPanelProps(
+  props: ThreadSecondaryPanelProps,
+): ThreadSecondaryPanelProps {
+  const pane = useOptionalPaneContext();
+  const state = useCompanionViews();
+  const ownsCompanions = pane === null || pane.isFocused;
+  const visibility = useCompanionPanelVisibility(
+    props.isOpen,
+    props.onClose,
+    props.onClose,
+    false,
+  );
+  const companions = ownsCompanions
+    ? state.entries.filter((entry) => entry.props.placement === "workbench")
+    : [];
+  if (companions.length === 0) return props;
+  const selectExisting = (select: () => void) => () => {
+    companionViewStore.select(null);
+    select();
+  };
+  const tabs: SecondaryPanelRenderableTab[] = [
+    ...props.tabs.map((tab) => ({
+      ...tab,
+      onSelect: selectExisting(tab.onSelect),
+    })),
+    ...companions.map((entry): SecondaryPanelRenderableTab => ({
+      tab: { id: `companion:${entry.key}`, kind: "companion" },
+      label: entry.props.title,
+      isPinned: entry.props.pinned === true,
+      leadingVisual: <Icon name={entry.props.icon ?? "LayoutPanelLeft"} />,
+      contentFillsRegion: true,
+      statusLabel: null,
+      onClose: () => entry.props.onClose(),
+      onSelect: () => {
+        companionViewStore.select(entry.key);
+        entry.props.onSelect();
+      },
+      renderContent: () => <CompanionPanelContent entry={entry} />,
+    })),
+  ];
+  const order = new Map(state.order.map((id, index) => [id, index]));
+  tabs.sort(
+    (a, b) =>
+      (order.get(a.tab.id) ?? Infinity) - (order.get(b.tab.id) ?? Infinity),
+  );
+  const selected = companions.find((entry) => entry.key === state.selected);
+  return {
+    ...props,
+    isOpen: visibility.open,
+    activeTab: selected
+      ? { id: `companion:${selected.key}`, kind: "companion" }
+      : props.activeTab,
+    onClose: visibility.onClose,
+    onCollapse: () => {
+      companionViewStore.show(false);
+      props.onCollapse();
+    },
+    onOpenNewTab: selectExisting(props.onOpenNewTab),
+    fixedTabs: props.fixedTabs.map((tab) => ({
+      ...tab,
+      onSelect: selectExisting(tab.onSelect),
+    })),
+    tabs,
+    onTabReorder: (request) => {
+      const ids = tabs.map((tab) => tab.tab.id);
+      const from = ids.indexOf(request.activeTabId);
+      const to = ids.indexOf(request.overTabId);
+      if (from < 0 || to < 0 || from === to) return;
+      const moved = ids.splice(from, 1)[0]!;
+      ids.splice(to, 0, moved);
+      companionViewStore.reorder(ids);
+      if (
+        props.tabs.some((tab) => tab.tab.id === request.activeTabId) &&
+        props.tabs.some((tab) => tab.tab.id === request.overTabId)
+      )
+        props.onTabReorder(request);
+    },
+  };
+}

+import { useLayoutEffect, useRef, useState, useSyncExternalStore } from "react";
+import { createPortal } from "react-dom";
+import type {
+  ExperimentalCompanionOutletProps,
+  ExperimentalCompanionViewProps,
+} from "@get-bb/plugin-sdk";
+import { usePluginId } from "./plugin-context";
+import { useOptionalPaneContext } from "@/views/thread-detail/PaneContext";
+import {
+  companionViewStore,
+  type CompanionViewEntry,
+} from "./companion-view-store";
+
+export const useCompanionViews = () =>
+  useSyncExternalStore(
+    companionViewStore.subscribe,
+    companionViewStore.getSnapshot,
+    companionViewStore.getSnapshot,
+  );
+
+export function PluginCompanionView(props: ExperimentalCompanionViewProps) {
+  const pluginId = usePluginId();
+  const key = JSON.stringify([pluginId, props.id]);
+  const [element] = useState(() => document.createElement("div"));
+  const home = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    const host = home.current;
+    if (host === null) return;
+    element.className = "flex h-full min-h-0 min-w-0 flex-col";
+    element.dataset.bbCompanionView = key;
+    element.dataset.bbPlugin = pluginId;
+    element.dataset.bbPluginRoot = "";
+    element.dataset.bbPortaledOverlay = "";
+    if (props.placement === "floating" || element.parentElement === null)
+      host.append(element);
+    companionViewStore.put({ key, props, element, home: host });
+  }, [element, key, pluginId, props]);
+  useLayoutEffect(
+    () => () => {
+      companionViewStore.remove(key, element);
+      element.remove();
+    },
+    [element, key],
+  );
+  return (
+    <div
+      ref={home}
+      className={
+        props.placement === "floating"
+          ? "flex min-h-0 flex-1 flex-col"
+          : "hidden"
+      }
+    >
+      {createPortal(props.children, element, key)}
+    </div>
+  );
+}
+
+export function CompanionViewOutlet({ entry }: { entry: CompanionViewEntry }) {
+  const host = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    const destination = host.current;
+    if (destination === null) return;
+    const focused = entry.element.contains(document.activeElement)
+      ? document.activeElement
+      : null;
+    const scroll = [...entry.element.querySelectorAll<HTMLElement>("*")]
+      .filter((node) => node.scrollTop !== 0 || node.scrollLeft !== 0)
+      .map((node) => ({ node, top: node.scrollTop, left: node.scrollLeft }));
+    destination.append(entry.element);
+    scroll.forEach(({ node, top, left }) => {
+      node.scrollTop = top;
+      node.scrollLeft = left;
+    });
+    if (focused instanceof HTMLElement) focused.focus({ preventScroll: true });
+    return () => {
+      if (entry.element.parentElement === destination)
+        entry.home.append(entry.element);
+    };
+  }, [entry.element, entry.home]);
+  return (
+    <div
+      ref={host}
+      className="flex h-full min-h-0 min-w-0 flex-col"
+      data-bb-companion-outlet={entry.key}
+    />
+  );
+}
+
+export function PluginCompanionOutlet({
+  id,
+}: ExperimentalCompanionOutletProps) {
+  const pluginId = usePluginId();
+  const pane = useOptionalPaneContext();
+  const key = JSON.stringify([pluginId, id]);
+  const entry = useCompanionViews().entries.find(
+    (candidate) =>
+      candidate.key === key && candidate.props.placement === "main",
+  );
+  return entry && (pane === null || pane.isFocused) ? (
+    <CompanionViewOutlet entry={entry} />
+  ) : null;
+}

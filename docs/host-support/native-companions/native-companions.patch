+import { getInstalledPlugin, type DbConnection } from "@bb/db";
+import {
+  PLUGIN_COMPANION_ACTION_CHANNEL,
+  pluginCompanionActionRequestSchema,
+} from "@bb/server-contract";
+import type { Hono } from "hono";
+import type { NotificationHub } from "../ws/hub.js";
+
+export function registerPluginCompanionRoutes(
+  app: Hono,
+  deps: { db: DbConnection; hub: Pick<NotificationHub, "notifyPluginSignal"> },
+): void {
+  app.post("/plugins/:id/companion-action", async (context) => {
+    const pluginId = context.req.param("id");
+    if (!getInstalledPlugin(deps.db, pluginId))
+      return context.json({ error: "unknown plugin" }, 404);
+    const body = pluginCompanionActionRequestSchema.safeParse(
+      await context.req.json().catch(() => null),
+    );
+    if (!body.success)
+      return context.json(
+        { error: "expected a companion id and supported action" },
+        400,
+      );
+    const delivered = deps.hub.notifyPluginSignal(
+      pluginId,
+      PLUGIN_COMPANION_ACTION_CHANNEL,
+      body.data,
+    );
+    return context.json({ delivered });
+  });
+}

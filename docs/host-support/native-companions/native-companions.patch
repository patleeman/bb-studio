+import {
+  createContext,
+  useContext,
+  useLayoutEffect,
+  useRef,
+  useState,
+  useSyncExternalStore,
+  type ReactNode,
+} from "react";
+import { createPortal } from "react-dom";
+import { PaneContext } from "@/views/thread-detail/PaneContext";
+import { BottomAnchorContext } from "@/components/ui/bottom-anchored-scroll-body";
+import { ThreadProviderContext } from "@/components/thread/thread-provider-context";
+import { PluginContext } from "@/components/plugin/plugin-context";
+
+export const CompanionComposerContext = createContext<{ show(): void } | null>(
+  null,
+);
+
+interface Registration {
+  id: string;
+  threadId: string;
+  element: HTMLElement;
+  content: ReactNode;
+  companion: { show(): void } | null;
+  focused: boolean;
+  focusOrder: number;
+}
+
+interface View {
+  element: HTMLDivElement;
+  id: string;
+  threadId: string;
+  mainId?: string;
+  destination: Registration;
+}
+
+export function createThreadComposerRetentionStore() {
+  const registrations = new Map<string, Registration>();
+  const listeners = new Set<() => void>();
+  let views: View[] = [];
+  let focusOrder = 0;
+  const refresh = () => {
+    const next: View[] = [];
+    const used = new Set<string>();
+    const all = [...registrations.values()];
+    const mains = all.filter((entry) => !entry.companion);
+    const take = (view: View) => {
+      used.add(view.id);
+      next.push(view);
+    };
+    for (const companion of all.filter((entry) => entry.companion)) {
+      const main = mains
+        .filter((entry) => entry.threadId === companion.threadId)
+        .sort(
+          (a, b) =>
+            b.focusOrder - a.focusOrder ||
+            Number(b.focused) - Number(a.focused),
+        )[0];
+      const existing =
+        views.find(
+          (view) =>
+            !used.has(view.id) &&
+            view.threadId === companion.threadId &&
+            view.destination.id === companion.id,
+        ) ??
+        views.find(
+          (view) =>
+            !used.has(view.id) &&
+            view.threadId === companion.threadId &&
+            view.mainId === main?.id,
+        );
+      const mainId = mains.some(
+        (candidate) => candidate.id === existing?.mainId,
+      )
+        ? existing?.mainId
+        : (main?.id ?? existing?.mainId);
+      take({
+        element: existing?.element ?? document.createElement("div"),
+        id: existing?.id ?? `${companion.id}:${companion.threadId}`,
+        threadId: companion.threadId,
+        mainId,
+        destination: companion,
+      });
+    }
+    for (const main of mains) {
+      if (next.some((view) => view.mainId === main.id)) continue;
+      const existing = views.find(
+        (view) =>
+          !used.has(view.id) &&
+          view.threadId === main.threadId &&
+          view.mainId === main.id,
+      );
+      take({
+        element: existing?.element ?? document.createElement("div"),
+        id: existing?.id ?? `${main.id}:${main.threadId}`,
+        threadId: main.threadId,
+        mainId: main.id,
+        destination: main,
+      });
+    }
+    views = next;
+    views.forEach((view) =>
+      moveComposerElement(view.element, view.destination.element),
+    );
+    listeners.forEach((listener) => listener());
+  };
+  return {
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    getSnapshot: () => views,
+    put: (entry: Omit<Registration, "focusOrder">) => {
+      registrations.set(entry.id, {
+        ...entry,
+        focusOrder: registrations.get(entry.id)?.focusOrder ?? 0,
+      });
+      refresh();
+    },
+    remove: (id: string) => {
+      if (registrations.delete(id)) refresh();
+    },
+    focus: (id: string) => {
+      const entry = registrations.get(id);
+      if (entry) {
+        entry.focusOrder = ++focusOrder;
+        refresh();
+      }
+    },
+    isMoved: (id: string) =>
+      views.some((view) => view.mainId === id && view.destination.id !== id),
+    show: (id: string) =>
+      views.find((view) => view.mainId === id)?.destination.companion?.show(),
+  };
+}
+
+const RetentionContext = createContext<ReturnType<
+  typeof createThreadComposerRetentionStore
+> | null>(null);
+
+function moveComposerElement(
+  element: HTMLDivElement,
+  destination: HTMLElement,
+) {
+  if (element.parentElement === destination) return;
+  element.className = "min-w-0";
+  const focused = element.contains(document.activeElement)
+    ? document.activeElement
+    : null;
+  const selection = window.getSelection();
+  const range =
+    selection?.rangeCount && element.contains(selection.anchorNode)
+      ? (() => {
+          return {
+            anchor: selection.anchorNode!,
+            anchorOffset: selection.anchorOffset,
+            focus: selection.focusNode!,
+            focusOffset: selection.focusOffset,
+          };
+        })()
+      : null;
+  const scroll = [element, ...element.querySelectorAll<HTMLElement>("*")]
+    .filter((node) => node.scrollTop || node.scrollLeft)
+    .map((node) => ({ node, top: node.scrollTop, left: node.scrollLeft }));
+  destination.append(element);
+  scroll.forEach(({ node, top, left }) => {
+    node.scrollTop = top;
+    node.scrollLeft = left;
+  });
+  if (focused instanceof HTMLElement) focused.focus({ preventScroll: true });
+  if (range && selection) {
+    selection.setBaseAndExtent(
+      range.anchor,
+      range.anchorOffset,
+      range.focus,
+      range.focusOffset,
+    );
+  }
+}
+
+function RetainedComposerView({ view }: { view: View }) {
+  useLayoutEffect(() => () => view.element.remove(), [view.element]);
+  return createPortal(view.destination.content, view.element, view.id);
+}
+
+function RetainedComposerViews({
+  store,
+}: {
+  store: ReturnType<typeof createThreadComposerRetentionStore>;
+}) {
+  const views = useSyncExternalStore(
+    store.subscribe,
+    store.getSnapshot,
+    store.getSnapshot,
+  );
+  return (
+    <>
+      {views.map((view) => (
+        <RetainedComposerView key={view.id} view={view} />
+      ))}
+    </>
+  );
+}
+
+export function ThreadComposerRetentionProvider({
+  children,
+}: {
+  children: ReactNode;
+}) {
+  const [store] = useState(createThreadComposerRetentionStore);
+  return (
+    <RetentionContext.Provider value={store}>
+      {children}
+      <RetainedComposerViews store={store} />
+    </RetentionContext.Provider>
+  );
+}
+
+export function RetainThreadComposer({
+  threadId,
+  main = false,
+  children,
+}: {
+  threadId: string | null;
+  main?: boolean;
+  children: ReactNode;
+}) {
+  const store = useContext(RetentionContext);
+  const companion = useContext(CompanionComposerContext);
+  if (!store || !threadId || (!main && !companion)) return <>{children}</>;
+  return (
+    <ThreadComposerSlot store={store} threadId={threadId} companion={companion}>
+      {children}
+    </ThreadComposerSlot>
+  );
+}
+
+function ThreadComposerSlot({
+  store,
+  threadId,
+  companion,
+  children,
+}: {
+  store: ReturnType<typeof createThreadComposerRetentionStore>;
+  threadId: string;
+  companion: { show(): void } | null;
+  children: ReactNode;
+}) {
+  const pane = useContext(PaneContext);
+  const anchor = useContext(BottomAnchorContext);
+  const provider = useContext(ThreadProviderContext);
+  const plugin = useContext(PluginContext);
+  const [id] = useState(() => crypto.randomUUID());
+  const destination = useRef<HTMLDivElement>(null);
+  const moved = useSyncExternalStore(
+    store.subscribe,
+    () => store.isMoved(id),
+    () => false,
+  );
+  useLayoutEffect(() => {
+    if (!destination.current) return;
+    store.put({
+      id,
+      threadId,
+      element: destination.current,
+      companion,
+      focused: pane?.isFocused ?? false,
+      content: (
+        <PaneContext.Provider value={pane}>
+          <BottomAnchorContext.Provider value={anchor}>
+            <ThreadProviderContext.Provider value={provider}>
+              <PluginContext.Provider value={plugin}>
+                {children}
+              </PluginContext.Provider>
+            </ThreadProviderContext.Provider>
+          </BottomAnchorContext.Provider>
+        </PaneContext.Provider>
+      ),
+    });
+  }, [
+    store,
+    id,
+    threadId,
+    companion,
+    pane,
+    anchor,
+    provider,
+    plugin,
+    children,
+  ]);
+  useLayoutEffect(() => {
+    const node = destination.current;
+    const focus = () => store.focus(id);
+    node?.addEventListener("focusin", focus);
+    return () => {
+      node?.removeEventListener("focusin", focus);
+      store.remove(id);
+    };
+  }, [store, id]);
+  return (
+    <div ref={destination} data-retained-thread-composer={threadId}>
+      {moved ? (
+        <div className="flex items-center justify-center gap-3 p-3 text-sm text-muted-foreground">
+          <span>This composer is open in a companion.</span>
+          <button
+            type="button"
+            className="rounded-md border border-border px-2 py-1 text-foreground"
+            onClick={() => store.show(id)}
+          >
+            Show companion
+          </button>
+        </div>
+      ) : null}
+    </div>
+  );
+}

+import type { ExperimentalCompanionViewProps } from "@get-bb/plugin-sdk";
+
+interface CompanionSession {
+  selected: string | null;
+  visible: boolean;
+  order: readonly string[];
+  entries: readonly {
+    key: string;
+    placement: ExperimentalCompanionViewProps["placement"];
+    activation: number;
+  }[];
+}
+
+export interface CompanionViewEntry {
+  key: string;
+  props: ExperimentalCompanionViewProps;
+  element: HTMLDivElement;
+  home: HTMLDivElement;
+}
+
+interface CompanionSnapshot {
+  entries: readonly CompanionViewEntry[];
+  selected: string | null;
+  visible: boolean;
+  order: readonly string[];
+  focusRequest: number;
+}
+
+export function createCompanionViewStore(
+  restored: CompanionSession | null = null,
+  save?: (session: CompanionSession) => void,
+) {
+  const baseline = new Map(
+    restored?.entries.map((entry) => [entry.key, entry]),
+  );
+  let state: CompanionSnapshot = {
+    entries: [],
+    selected: restored?.selected ?? null,
+    visible: restored?.visible ?? false,
+    order: restored?.order ?? [],
+    focusRequest: 0,
+  };
+  const listeners = new Set<() => void>();
+  const publish = (next: CompanionSnapshot) => {
+    state = next;
+    save?.({
+      selected: next.selected,
+      visible: next.visible,
+      order: next.order,
+      entries: next.entries.map((entry) => ({
+        key: entry.key,
+        placement: entry.props.placement,
+        activation: entry.props.activation,
+      })),
+    });
+    listeners.forEach((listener) => listener());
+  };
+  return {
+    getSnapshot: () => state,
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    put: (entry: CompanionViewEntry) => {
+      const previous = state.entries.find(
+        (candidate) => candidate.key === entry.key,
+      );
+      const saved = baseline.get(entry.key);
+      if (
+        previous &&
+        previous.element === entry.element &&
+        previous.home === entry.home &&
+        previous.props.title === entry.props.title &&
+        previous.props.icon === entry.props.icon &&
+        previous.props.placement === entry.props.placement &&
+        previous.props.activation === entry.props.activation &&
+        previous.props.pinned === entry.props.pinned &&
+        Boolean(previous.props.onBack) === Boolean(entry.props.onBack) &&
+        Boolean(previous.props.onPinnedChange) ===
+          Boolean(entry.props.onPinnedChange)
+      ) {
+        previous.props = entry.props;
+        return;
+      }
+      const requested =
+        entry.props.activation > 0 &&
+        entry.props.placement === "workbench" &&
+        ((previous?.props.placement ?? saved?.placement) !== "workbench" ||
+          (previous?.props.activation ?? saved?.activation) !==
+            entry.props.activation);
+      const entries = previous
+        ? state.entries.map((candidate) =>
+            candidate.key === entry.key ? entry : candidate,
+          )
+        : [...state.entries, entry];
+      const workbench = entries.filter(
+        (candidate) => candidate.props.placement === "workbench",
+      );
+      const selected = requested
+        ? entry.key
+        : workbench.some((candidate) => candidate.key === state.selected)
+          ? state.selected
+          : baseline.has(state.selected ?? "") &&
+              !entries.some((candidate) => candidate.key === state.selected)
+            ? state.selected
+            : null;
+      baseline.delete(entry.key);
+      publish({
+        ...state,
+        entries,
+        selected,
+        visible:
+          (workbench.length > 0 ||
+            [...baseline.values()].some(
+              (entry) => entry.placement === "workbench",
+            )) &&
+          (requested || state.visible),
+        focusRequest: state.focusRequest + (requested ? 1 : 0),
+      });
+    },
+    remove: (key: string, element: HTMLDivElement) => {
+      if (
+        !state.entries.some(
+          (entry) => entry.key === key && entry.element === element,
+        )
+      )
+        return;
+      const entries = state.entries.filter((entry) => entry.key !== key);
+      const workbench = entries.filter(
+        (entry) => entry.props.placement === "workbench",
+      );
+      publish({
+        ...state,
+        entries,
+        selected:
+          state.selected === key
+            ? (workbench.at(-1)?.key ?? null)
+            : state.selected,
+        visible: state.visible && workbench.length > 0,
+      });
+    },
+    select: (key: string | null) => {
+      if (
+        key !== null &&
+        !state.entries.some(
+          (entry) => entry.key === key && entry.props.placement === "workbench",
+        )
+      )
+        return;
+      if (state.selected === key) return;
+      publish({ ...state, selected: key });
+    },
+    show: (visible: boolean) => {
+      if (state.visible !== visible)
+        publish({
+          ...state,
+          visible,
+          focusRequest: state.focusRequest + (visible ? 1 : 0),
+        });
+    },
+    reorder: (order: readonly string[]) => publish({ ...state, order }),
+  };
+}
+
+const SESSION_KEY = "bb:companion-views:v1";
+
+export function parseCompanionSession(value: unknown): CompanionSession | null {
+  if (value === null || typeof value !== "object") return null;
+  const saved = value as Record<string, unknown>;
+  if (!Array.isArray(saved.entries) || !Array.isArray(saved.order)) return null;
+  const entries: CompanionSession["entries"][number][] = [];
+  for (const raw of saved.entries) {
+    if (raw === null || typeof raw !== "object") continue;
+    const entry = raw as Record<string, unknown>;
+    if (
+      typeof entry.key !== "string" ||
+      typeof entry.activation !== "number" ||
+      !Number.isSafeInteger(entry.activation) ||
+      entry.activation < 0
+    )
+      continue;
+    if (
+      entry.placement !== "workbench" &&
+      entry.placement !== "main" &&
+      entry.placement !== "floating"
+    )
+      continue;
+    entries.push({
+      key: entry.key,
+      placement: entry.placement,
+      activation: entry.activation,
+    });
+  }
+  return {
+    entries,
+    order: saved.order.filter((id): id is string => typeof id === "string"),
+    selected: typeof saved.selected === "string" ? saved.selected : null,
+    visible: saved.visible === true,
+  };
+}
+
+function readSession(): CompanionSession | null {
+  try {
+    return parseCompanionSession(
+      JSON.parse(sessionStorage.getItem(SESSION_KEY) ?? "null"),
+    );
+  } catch {
+    return null;
+  }
+}
+
+export const companionViewStore = createCompanionViewStore(
+  readSession(),
+  (session) => {
+    try {
+      sessionStorage.setItem(SESSION_KEY, JSON.stringify(session));
+    } catch {
+      return;
+    }
+  },
+);

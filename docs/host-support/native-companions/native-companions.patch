+// @vitest-environment jsdom
+
+import { StrictMode, useState } from "react";
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+} from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type {
+  ExperimentalCompanionPlacement,
+  ExperimentalCompanionViewProps,
+} from "@get-bb/plugin-sdk";
+import { TooltipProvider } from "@bb/shared-ui/tooltip";
+import { PanelGroup } from "react-resizable-panels";
+import { PluginContext } from "./plugin-context";
+import {
+  companionViewStore,
+  createCompanionViewStore,
+  parseCompanionSession,
+} from "./companion-view-store";
+import { useCompanionPanelVisibility } from "./useCompanionPanel";
+import {
+  PluginCompanionView,
+  PluginCompanionOutlet,
+} from "./PluginCompanionView";
+import { ThreadSecondaryPanel } from "@/components/secondary-panel/ThreadSecondaryPanel";
+import {
+  createBrowserFixedPanelTab,
+  createTerminalFixedPanelTab,
+} from "@/lib/fixed-panel-tabs-state";
+import { createQueryClientTestHarness } from "@/test/queryClientTestHarness";
+
+const noop = () => {};
+const browser = createBrowserFixedPanelTab({
+  environmentId: null,
+  url: "https://example.com",
+});
+const terminal = createTerminalFixedPanelTab({ terminalId: "terminal-demo" });
+
+beforeEach(() => {
+  vi.spyOn(HTMLElement.prototype, "clientWidth", "get").mockReturnValue(1000);
+});
+
+afterEach(() => {
+  cleanup();
+  companionViewStore
+    .getSnapshot()
+    .entries.forEach((entry) =>
+      companionViewStore.remove(entry.key, entry.element),
+    );
+  companionViewStore.reorder([]);
+  window.localStorage.clear();
+  vi.restoreAllMocks();
+});
+
+function Editor() {
+  const [draft, setDraft] = useState("");
+  const [count, setCount] = useState(0);
+  return (
+    <div data-testid="scroll" style={{ overflow: "auto", height: 100 }}>
+      <textarea
+        aria-label="Draft"
+        value={draft}
+        onChange={(event) => setDraft(event.target.value)}
+      />
+      <input type="file" aria-label="Attachment" />
+      <button onClick={() => setCount(count + 1)}>Edits: {count}</button>
+      <div style={{ height: 1000 }} />
+    </div>
+  );
+}
+
+function Experience({ route }: { route: string }) {
+  const [placement, setPlacement] =
+    useState<ExperimentalCompanionPlacement>("floating");
+  const [activation, setActivation] = useState(1);
+  const [pinned, setPinned] = useState(false);
+  const [closed, setClosed] = useState(false);
+  const [nativeActive, setNativeActive] = useState(browser);
+  const move = (next: ExperimentalCompanionPlacement) => {
+    setPlacement(next);
+    setActivation((value) => value + 1);
+  };
+  return (
+    <PluginContext.Provider value="studio-demo">
+      <button onClick={() => move("workbench")}>Dock editor</button>
+      <button onClick={() => move("floating")}>Float editor</button>
+      <button
+        onClick={() => {
+          companionViewStore.show(true);
+        }}
+      >
+        Reveal panel
+      </button>
+      {!closed ? (
+        <PluginCompanionView
+          id="editor"
+          title="Demo editor"
+          activation={activation}
+          placement={placement}
+          pinned={pinned}
+          onPinnedChange={setPinned}
+          onSelect={() => setActivation((value) => value + 1)}
+          onClose={() => setClosed(true)}
+          onPlacementChange={move}
+        >
+          <Editor />
+        </PluginCompanionView>
+      ) : null}
+      <PanelGroup direction="horizontal" key={route}>
+        <ThreadSecondaryPanel
+          activeTab={nativeActive}
+          canUseGitUi={false}
+          fixedTabs={[]}
+          tabs={[
+            {
+              tab: browser,
+              label: "Browser",
+              leadingVisual: null,
+              statusLabel: null,
+              onClose: noop,
+              onSelect: () => setNativeActive(browser),
+              renderContent: () => <div>Browser content</div>,
+            },
+            {
+              tab: terminal,
+              label: "Terminal",
+              leadingVisual: null,
+              statusLabel: null,
+              onClose: noop,
+              onSelect: noop,
+              renderContent: () => <div>Terminal content</div>,
+            },
+          ]}
+          isOpen={false}
+          metadataContent={null}
+          onClose={noop}
+          onCollapse={noop}
+          onTabReorder={noop}
+          onOpenNewTab={noop}
+          onPanelFocus={noop}
+          isConversationCollapsed={false}
+          onToggleConversationCollapse={noop}
+          renderAsDrawer
+        />
+      </PanelGroup>
+      <div data-testid="main-outlet">
+        <PluginCompanionOutlet id="editor" />
+      </div>
+    </PluginContext.Provider>
+  );
+}
+
+function renderExperience(route = "page-a") {
+  const { wrapper: Wrapper } = createQueryClientTestHarness();
+  const view = (current: string) => (
+    <StrictMode>
+      <Wrapper>
+        <TooltipProvider>
+          <Experience route={current} />
+        </TooltipProvider>
+      </Wrapper>
+    </StrictMode>
+  );
+  const result = render(view(route));
+  return {
+    ...result,
+    route: (current: string) => result.rerender(view(current)),
+  };
+}
+
+describe("retained native companion views", () => {
+  it("keeps equal companion ids isolated by plugin ownership and preserves the CSS root after transfer", () => {
+    const props: ExperimentalCompanionViewProps = {
+      id: "same",
+      title: "View",
+      placement: "main",
+      activation: 1,
+      onSelect: noop,
+      onClose: noop,
+      onPlacementChange: noop,
+      children: null,
+    };
+    render(
+      <>
+        <PluginContext.Provider value="pages">
+          <PluginCompanionView {...props}>
+            <textarea aria-label="Page editor" />
+          </PluginCompanionView>
+          <PluginCompanionOutlet id="same" />
+        </PluginContext.Provider>
+        <PluginContext.Provider value="draw">
+          <PluginCompanionView {...props}>
+            <textarea aria-label="Drawing editor" />
+          </PluginCompanionView>
+          <PluginCompanionOutlet id="same" />
+        </PluginContext.Provider>
+      </>,
+    );
+    const page = screen.getByRole("textbox", { name: "Page editor" });
+    const drawing = screen.getByRole("textbox", { name: "Drawing editor" });
+    expect(
+      page.closest("[data-bb-plugin-root]")?.getAttribute("data-bb-plugin"),
+    ).toBe("pages");
+    expect(
+      drawing.closest("[data-bb-plugin-root]")?.getAttribute("data-bb-plugin"),
+    ).toBe("draw");
+    expect(page.closest("[data-bb-companion-outlet]")).not.toBe(
+      drawing.closest("[data-bb-companion-outlet]"),
+    );
+    expect(companionViewStore.getSnapshot().entries).toHaveLength(2);
+  });
+  it("moves the same editor, attachment, and scroll state through floating, native workbench, routes, and main", () => {
+    const result = renderExperience();
+    const input = screen.getByRole("textbox", { name: "Draft" });
+    const attachment = screen.getByLabelText("Attachment");
+    const scroll = screen.getByTestId("scroll");
+    const files = [new File(["demo"], "notes.txt")];
+    fireEvent.change(input, { target: { value: "Keep this draft" } });
+    fireEvent.change(attachment, { target: { files } });
+    fireEvent.click(screen.getByText("Edits: 0"));
+    scroll.scrollTop = 57;
+    fireEvent.click(screen.getByText("Dock editor"));
+    expect(screen.getByRole("button", { name: "Browser" })).toBeTruthy();
+    expect(screen.getByRole("button", { name: "Terminal" })).toBeTruthy();
+    expect(screen.getByRole("button", { name: "Demo editor" })).toBeTruthy();
+    expect(input.closest("[data-bb-companion-outlet]")).toBeTruthy();
+    result.route("drawing-b");
+    expect(screen.getByRole("textbox", { name: "Draft" })).toBe(input);
+    expect(scroll.scrollTop).toBe(57);
+    fireEvent.click(screen.getByRole("button", { name: "Main view" }));
+    expect(screen.getByTestId("main-outlet").contains(input)).toBe(true);
+    fireEvent.click(screen.getByText("Float editor"));
+    expect(screen.getByRole("textbox", { name: "Draft" })).toBe(input);
+    expect((input as HTMLTextAreaElement).value).toBe("Keep this draft");
+    expect((attachment as HTMLInputElement).files).toBe(files);
+    expect(screen.getByText("Edits: 1")).toBeTruthy();
+    expect(scroll.scrollTop).toBe(57);
+  });
+
+  it("retains the companion while Browser is selected and a hidden panel is dismissed, then refocuses on an explicit request", () => {
+    renderExperience();
+    const input = screen.getByRole("textbox", { name: "Draft" });
+    fireEvent.change(input, { target: { value: "Unsent" } });
+    fireEvent.click(screen.getByText("Dock editor"));
+    fireEvent.click(screen.getByRole("button", { name: "Browser" }));
+    expect(companionViewStore.getSnapshot().selected).toBeNull();
+    expect((input as HTMLTextAreaElement).value).toBe("Unsent");
+    fireEvent.click(screen.getByText("Dock editor"));
+    expect(input.closest("[data-bb-companion-outlet]")).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Hide right panel" }));
+    expect(companionViewStore.getSnapshot().visible).toBe(false);
+    act(() => {
+      companionViewStore.put({
+        ...companionViewStore.getSnapshot().entries[0]!,
+      });
+    });
+    expect(companionViewStore.getSnapshot().visible).toBe(false);
+    fireEvent.click(screen.getByText("Dock editor"));
+    expect(companionViewStore.getSnapshot().visible).toBe(true);
+    expect(screen.getByRole("textbox", { name: "Draft" })).toBe(input);
+  });
+
+  it("protects a pinned native tab from bulk close and disposes it only when explicitly closed", () => {
+    renderExperience();
+    fireEvent.click(screen.getByText("Dock editor"));
+    fireEvent.click(screen.getByRole("button", { name: "Pin companion" }));
+    expect(companionViewStore.getSnapshot().entries[0]?.props.pinned).toBe(
+      true,
+    );
+    expect(
+      screen.queryByRole("button", { name: "Close Demo editor" }),
+    ).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Unpin companion" }));
+    const entry = companionViewStore.getSnapshot().entries[0]!;
+    act(entry.props.onClose);
+    expect(companionViewStore.getSnapshot().entries).toHaveLength(0);
+    expect(screen.queryByRole("textbox", { name: "Draft" })).toBeNull();
+  });
+});
+
+describe("companion selection policy", () => {
+  it("keeps native header and keyboard toggles consistent with companion requests and dismissal", () => {
+    function Owner({
+      activation,
+      title,
+    }: {
+      activation: number;
+      title: string;
+    }) {
+      const [open, setOpen] = useState(false);
+      const toggle = () => setOpen((value) => !value);
+      const visibility = useCompanionPanelVisibility(open, toggle, () =>
+        setOpen(false),
+      );
+      return (
+        <PluginContext.Provider value="owner">
+          <button onClick={toggle}>Native toggle</button>
+          <output>
+            {visibility.open ? "Visible" : "Hidden"}:
+            {open ? "Native open" : "Native closed"}
+          </output>
+          <PluginCompanionView
+            id="one"
+            title={title}
+            placement="workbench"
+            activation={activation}
+            onSelect={noop}
+            onClose={noop}
+            onPlacementChange={noop}
+          >
+            <textarea />
+          </PluginCompanionView>
+        </PluginContext.Provider>
+      );
+    }
+    const result = render(<Owner activation={1} title="One" />);
+    expect(screen.getByText("Visible:Native open")).toBeTruthy();
+    fireEvent.click(screen.getByText("Native toggle"));
+    expect(screen.getByText("Hidden:Native closed")).toBeTruthy();
+    result.rerender(<Owner activation={1} title="Updated" />);
+    expect(screen.getByText("Hidden:Native closed")).toBeTruthy();
+    result.rerender(<Owner activation={2} title="Updated" />);
+    expect(screen.getByText("Visible:Native open")).toBeTruthy();
+  });
+
+  it("restores dismissal, active identity, and native order without treating restored views as new focus requests", () => {
+    let saved: Parameters<typeof createCompanionViewStore>[0] = null;
+    const store = createCompanionViewStore(null, (session) => {
+      saved = session;
+    });
+    const make = (key: string, activation: number) => ({
+      key,
+      props: {
+        id: key,
+        title: key,
+        placement: "workbench" as const,
+        activation,
+        onSelect: noop,
+        onClose: noop,
+        onPlacementChange: noop,
+        children: null,
+      },
+      element: document.createElement("div"),
+      home: document.createElement("div"),
+    });
+    store.put(make("one", 1));
+    store.put(make("two", 1));
+    store.reorder(["native-browser", "two", "one"]);
+    store.show(false);
+    const restored = createCompanionViewStore(
+      parseCompanionSession(JSON.parse(JSON.stringify(saved))),
+    );
+    restored.put(make("one", 1));
+    restored.put(make("two", 1));
+    expect(restored.getSnapshot()).toMatchObject({
+      selected: "two",
+      visible: false,
+      order: ["native-browser", "two", "one"],
+    });
+    restored.put(make("two", 2));
+    expect(restored.getSnapshot().visible).toBe(true);
+    expect(restored.getSnapshot().selected).toBe("two");
+    expect(
+      parseCompanionSession({
+        entries: [{ key: "bad", placement: "other", activation: "one" }],
+        order: [5, "native-browser"],
+        selected: false,
+        visible: "yes",
+      }),
+    ).toEqual({
+      entries: [],
+      order: ["native-browser"],
+      selected: null,
+      visible: false,
+    });
+  });
+  it("background registration does not override dismissal or steal a selected native tab", () => {
+    const store = createCompanionViewStore();
+    const props: ExperimentalCompanionViewProps = {
+      id: "one",
+      title: "One",
+      placement: "workbench",
+      activation: 0,
+      onSelect: noop,
+      onClose: noop,
+      onPlacementChange: noop,
+      children: null,
+    };
+    const entry = {
+      key: "one",
+      props,
+      element: document.createElement("div"),
+      home: document.createElement("div"),
+    };
+    store.put(entry);
+    expect(store.getSnapshot().visible).toBe(false);
+    store.put({ ...entry, props: { ...props, activation: 1 } });
+    expect(store.getSnapshot().selected).toBe("one");
+    store.show(false);
+    store.put({
+      ...entry,
+      props: { ...props, activation: 1, title: "Updated" },
+    });
+    expect(store.getSnapshot().visible).toBe(false);
+    store.put({ ...entry, props: { ...props, activation: 2 } });
+    expect(store.getSnapshot().visible).toBe(true);
+    store.put({
+      ...entry,
+      props: { ...props, placement: "floating", activation: 3 },
+    });
+    expect(store.getSnapshot().visible).toBe(false);
+    expect(store.getSnapshot().selected).toBeNull();
+  });
+});

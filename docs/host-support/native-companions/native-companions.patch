+import { mkdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createBbSdk } from "@bb/sdk/core";
+import { createHttpTransport } from "@bb/sdk/node";
+import {
+  PLUGIN_COMPANION_ACTION_CHANNEL,
+  pluginCompanionActionSchema,
+} from "@bb/server-contract";
+import { withTestHarness } from "../helpers/test-app.js";
+import { createMockHubSocket } from "../helpers/mock-hub-socket.js";
+
+it("validates remote companion requests and delivers owner-scoped SDK actions without an app acknowledgement", async () => {
+  await withTestHarness(async (harness) => {
+    const root = join(harness.config.dataDir, "companion-fixture");
+    await mkdir(root);
+    await writeFile(
+      join(root, "package.json"),
+      JSON.stringify({
+        name: "bb-plugin-companion-fixture",
+        version: "1.0.0",
+        bb: {
+          name: "Fixture",
+          description: "Companion controls",
+          branding: { icon: "Zap" },
+          server: "./server.ts",
+        },
+      }),
+    );
+    await writeFile(
+      join(root, "server.ts"),
+      "export default function plugin() {}\n",
+    );
+    const plugin = await harness.pluginService.installPath(root);
+    const sdk = createBbSdk({
+      transport: createHttpTransport({
+        baseUrl: "http://127.0.0.1:3334",
+        runtime: "node",
+        fetch: async (input, init) => harness.app.request(String(input), init),
+      }),
+    });
+    await expect(
+      sdk.plugins.experimental_companionAction({
+        pluginId: plugin.id,
+        id: "page:1",
+        action: "dock",
+      }),
+    ).resolves.toEqual({ delivered: 0 });
+    const sockets = [createMockHubSocket(), createMockHubSocket()];
+    sockets.forEach((socket) => harness.hub.registerClient(socket));
+    for (const action of pluginCompanionActionSchema.options)
+      await expect(
+        sdk.plugins.experimental_companionAction({
+          pluginId: plugin.id,
+          id: "page:1",
+          action,
+        }),
+      ).resolves.toEqual({ delivered: 2 });
+    const signals = sockets.map((socket) =>
+      socket.messages.map((message) => JSON.parse(message)),
+    );
+    expect(signals[0]).toEqual(
+      pluginCompanionActionSchema.options.map((action) => ({
+        type: "plugin-signal",
+        pluginId: plugin.id,
+        channel: PLUGIN_COMPANION_ACTION_CHANNEL,
+        payload: { id: "page:1", action },
+      })),
+    );
+    expect(signals[1]).toEqual(signals[0]);
+    for (const body of [
+      { id: "", action: "dock" },
+      { id: "page:1", action: "reset" },
+      { id: "page:1", action: "dock", pluginId: "other" },
+    ]) {
+      const response = await harness.app.request(
+        `/api/v1/plugins/${plugin.id}/companion-action`,
+        {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(body),
+        },
+      );
+      expect(response.status).toBe(400);
+    }
+    const unknown = await harness.app.request(
+      "/api/v1/plugins/missing/companion-action",
+      {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ id: "page:1", action: "close" }),
+      },
+    );
+    expect(unknown.status).toBe(404);
+    expect(sockets[0]?.messages).toHaveLength(
+      pluginCompanionActionSchema.options.length,
+    );
+  });
+});

@@ -0,0 +1,39 @@
+export function createMainCompanionOutletRegistry() {
+  const outlets = new Map<string, Map<symbol, boolean>>();
+  const owners = new Map<string, symbol>();
+  const listeners = new Set<() => void>();
+  let revision = 0;
+  const updateOwner = (key: string) => {
+    const entries = outlets.get(key);
+    const current = owners.get(key);
+    const owner = [...(entries ?? [])].find(([, focused]) => focused)?.[0]
+      ?? (current && entries?.has(current) ? current : entries?.keys().next().value);
+    if (owner === current) return;
+    if (owner) owners.set(key, owner);
+    else owners.delete(key);
+    revision += 1;
+    listeners.forEach(listener => listener());
+  };
+  return {
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => { listeners.delete(listener); };
+    },
+    getSnapshot: () => revision,
+    owns: (key: string, token: symbol) => owners.get(key) === token,
+    put: (key: string, token: symbol, focused: boolean) => {
+      const entries = outlets.get(key) ?? new Map<symbol, boolean>();
+      entries.set(token, focused);
+      outlets.set(key, entries);
+      updateOwner(key);
+    },
+    remove: (key: string, token: symbol) => {
+      const entries = outlets.get(key);
+      entries?.delete(token);
+      if (entries?.size === 0) outlets.delete(key);
+      updateOwner(key);
+    },
+  };
+}
+
+export const mainCompanionOutlets = createMainCompanionOutletRegistry();

{
  "pluginId": "design",
  "methods": {
    "getDesign": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "design": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "projectId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "threadId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "updatedAt": {
                    "type": "number"
                  },
                  "rounds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "round": {
                          "type": "number"
                        },
                        "title": {
                          "type": "string"
                        },
                        "intro": {
                          "type": "string"
                        },
                        "screens": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "round": {
                                "type": "number"
                              },
                              "option": {
                                "type": "string"
                              },
                              "title": {
                                "type": "string"
                              },
                              "caption": {
                                "type": "string"
                              },
                              "viewport": {},
                              "updatedAt": {
                                "type": "number"
                              },
                              "steps": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string"
                                    },
                                    "label": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "label"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "id",
                              "round",
                              "option",
                              "title",
                              "caption",
                              "viewport",
                              "updatedAt",
                              "steps"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "round",
                        "title",
                        "intro",
                        "screens"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "comments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "screenId": {
                          "type": "string"
                        },
                        "step": {
                          "type": "string"
                        },
                        "selector": {
                          "type": "string"
                        },
                        "elementText": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "number"
                        },
                        "sent": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "screenId",
                        "step",
                        "selector",
                        "elementText",
                        "body",
                        "createdAt",
                        "sent"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "review": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "reviewing",
                              "done",
                              "needs_work",
                              "failed"
                            ]
                          },
                          "round": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "screens": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "at": {
                            "type": "number"
                          },
                          "summary": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "state",
                          "round",
                          "screens",
                          "at",
                          "summary"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "projectId",
                  "threadId",
                  "updatedAt",
                  "rounds",
                  "comments",
                  "review"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "design"
        ],
        "additionalProperties": false
      }
    },
    "renameDesign": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "deleteDesign": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "addComment": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "designId": {
            "type": "string"
          },
          "screenId": {
            "type": "string",
            "pattern": "^([1-9][0-9]{0,2})([a-z])$"
          },
          "step": {
            "default": "",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{0,40}$"
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "elementHtml": {
            "type": "string",
            "maxLength": 5000
          },
          "elementText": {
            "type": "string",
            "maxLength": 400
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "send": {
            "type": "boolean"
          }
        },
        "required": [
          "designId",
          "screenId",
          "selector",
          "elementHtml",
          "elementText",
          "body",
          "send"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "sent"
        ],
        "additionalProperties": false
      }
    },
    "editText": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "designId": {
            "type": "string"
          },
          "screenId": {
            "type": "string",
            "pattern": "^([1-9][0-9]{0,2})([a-z])$"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "after": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "designId",
          "screenId",
          "before",
          "after"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "missing",
              "ambiguous",
              "markup"
            ]
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "sendComment": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "resolveComment": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "resolved"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "deleteComment": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    }
  }
}

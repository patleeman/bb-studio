{
  "pluginId": "mobile",
  "methods": {
    "mute_list": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    },
    "notify": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "kind": {
            "type": "string",
            "enum": [
              "turn-finished",
              "thread-error",
              "pending-interaction"
            ]
          },
          "threadId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "const": "BB_LOOP"
          },
          "loopId": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "done",
                "snooze",
                "got_it",
                "drop",
                "choose",
                "hand_off",
                "nudge"
              ]
            }
          },
          "loopKind": {
            "type": "string",
            "enum": [
              "do",
              "decide",
              "read",
              "waiting"
            ]
          },
          "options": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "coalesceKey": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "title",
          "body",
          "kind",
          "threadId",
          "projectId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "sent": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "sent"
        ],
        "additionalProperties": false
      }
    },
    "push_status": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "devices": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastDelivery": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "number"
                  },
                  "sent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "at",
                  "sent"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ready",
          "problem",
          "devices",
          "lastDelivery"
        ],
        "additionalProperties": false
      }
    },
    "push_test": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "sent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "sent",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "mute_set": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "pattern": "^thr_[A-Za-z0-9]+$"
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "threadId",
          "muted"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    }
  }
}

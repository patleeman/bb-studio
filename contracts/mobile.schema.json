{
  "pluginId": "mobile",
  "methods": {
    "live_register": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pushToStartToken": {
            "type": "string"
          },
          "activityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "activityToken": {
            "type": "string"
          },
          "threadId": {
            "type": "string",
            "pattern": "^thr_[A-Za-z0-9]+$"
          },
          "endedActivityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "mute_list": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    },
    "notify": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "kind": {
            "type": "string",
            "enum": [
              "turn-finished",
              "thread-error",
              "pending-interaction"
            ]
          },
          "threadId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "coalesceKey": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "title",
          "body",
          "kind",
          "threadId",
          "projectId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "sent": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "sent"
        ],
        "additionalProperties": false
      }
    },
    "mute_set": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "pattern": "^thr_[A-Za-z0-9]+$"
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "threadId",
          "muted"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "threadIds"
        ],
        "additionalProperties": false
      }
    }
  }
}

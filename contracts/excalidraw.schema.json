            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "number"
                },
                "updatedAt": {
                  "type": "number"
                },
                "elementCount": {
                  "type": "number"
                },
                "projectId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "archived": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "createdAt",
                "updatedAt",
                "elementCount",
                "projectId",
                "archived"
              ],
              "additionalProperties": false

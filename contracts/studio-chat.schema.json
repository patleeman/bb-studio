{
  "pluginId": "studio-chat",
  "methods": {
    "viewing": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "path"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "item": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "pluginId": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "kindLabel": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "icon": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kindIcon": {
                    "type": "string"
                  },
                  "projectId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "pluginId",
                  "id",
                  "kind",
                  "kindLabel",
                  "title",
                  "icon",
                  "kindIcon",
                  "projectId",
                  "href"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item"
        ],
        "additionalProperties": false
      }
    },
    "start": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "item": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "pluginId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "pluginId",
                  "id"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "request": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1
              },
              "providerId": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string"
              },
              "reasoningLevel": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra",
                  "ultracode"
                ]
              },
              "permissionMode": {
                "type": "string",
                "enum": [
                  "accept-edits",
                  "auto",
                  "full"
                ]
              },
              "serviceTier": {
                "type": "string",
                "enum": [
                  "default",
                  "fast"
                ]
              },
              "executionInputSources": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "client-preference",
                      "explicit"
                    ]
                  },
                  "permissionMode": {
                    "type": "string",
                    "enum": [
                      "client-preference",
                      "explicit"
                    ]
                  },
                  "providerId": {
                    "type": "string",
                    "enum": [
                      "client-preference",
                      "explicit"
                    ]
                  },
                  "reasoningLevel": {
                    "type": "string",
                    "enum": [
                      "client-preference",
                      "explicit"
                    ]
                  },
                  "serviceTier": {
                    "type": "string",
                    "enum": [
                      "client-preference",
                      "explicit"
                    ]
                  }
                }
              },
              "environment": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "input": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema1"
                  }
                }
              },
              "sendAt": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "projectId",
              "providerId",
              "model",
              "reasoningLevel",
              "permissionMode",
              "executionInputSources",
              "environment",
              "input"
            ]
          }
        },
        "required": [
          "item",
          "request"
        ],
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          },
          "__schema1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema1"
                }
              }
            ]
          }
        }
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId"
        ],
        "additionalProperties": false
      }
    },
    "lastThread": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "pluginId",
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "threadId"
        ],
        "additionalProperties": false
      }
    },
    "link": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "pluginId",
          "id",
          "threadId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    }
  }
}

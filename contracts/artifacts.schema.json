{
  "pluginId": "artifacts",
  "methods": {
    "get": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "projectId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceThreadId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourcePath": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "createdAt": {
                    "type": "number"
                  },
                  "updatedAt": {
                    "type": "number"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "number": {
                        "type": "number"
                      },
                      "name": {
                        "type": "string"
                      },
                      "mime": {
                        "type": "string"
                      },
                      "size": {
                        "type": "number"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "image",
                          "html",
                          "markdown",
                          "code",
                          "text",
                          "pdf",
                          "other"
                        ]
                      },
                      "createdAt": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "id",
                      "number",
                      "name",
                      "mime",
                      "size",
                      "type",
                      "createdAt"
                    ],
                    "additionalProperties": false
                  },
                  "versions": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "projectId",
                  "sourceThreadId",
                  "sourcePath",
                  "createdAt",
                  "updatedAt",
                  "archived",
                  "version",
                  "versions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "mime": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "html",
                    "markdown",
                    "code",
                    "text",
                    "pdf",
                    "other"
                  ]
                },
                "createdAt": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "number",
                "name",
                "mime",
                "size",
                "type",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "artifact",
          "versions"
        ],
        "additionalProperties": false
      }
    },
    "text": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "versionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "versionId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "update": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "delete": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "move": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "projectId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "threadArtifacts": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "threadId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "projectId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourceThreadId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourcePath": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "number"
                },
                "updatedAt": {
                  "type": "number"
                },
                "archived": {
                  "type": "boolean"
                },
                "version": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "number": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "mime": {
                      "type": "string"
                    },
                    "size": {
                      "type": "number"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "image",
                        "html",
                        "markdown",
                        "code",
                        "text",
                        "pdf",
                        "other"
                      ]
                    },
                    "createdAt": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "number",
                    "name",
                    "mime",
                    "size",
                    "type",
                    "createdAt"
                  ],
                  "additionalProperties": false
                },
                "versions": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "projectId",
                "sourceThreadId",
                "sourcePath",
                "createdAt",
                "updatedAt",
                "archived",
                "version",
                "versions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "artifacts"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "seq": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "threadId",
          "seq"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reply": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "display": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "created",
                    "changed",
                    "storage"
                  ]
                },
                "artifactId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "display",
                "kind",
                "artifactId"
              ],
              "additionalProperties": false
            }
          },
          "storage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "display": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "created",
                    "changed",
                    "storage"
                  ]
                },
                "artifactId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "display",
                "kind",
                "artifactId"
              ],
              "additionalProperties": false
            }
          },
          "storageError": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "reply",
          "storage",
          "storageError"
        ],
        "additionalProperties": false
      }
    },
    "saveFiles": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "paths": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "required": [
          "threadId",
          "paths"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "saved": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "artifactId": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "created",
                    "versioned",
                    "unchanged"
                  ]
                },
                "restored": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "artifactId",
                "outcome",
                "restored"
              ],
              "additionalProperties": false
            }
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "error"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "saved",
          "failed"
        ],
        "additionalProperties": false
      }
    },
    "saveAsPage": {
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          }
        },
        "required": [
          "href"
        ],
        "additionalProperties": false
      }
    }
  }
}

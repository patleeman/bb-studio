{
  "name": "bb-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:compat": "node scripts/check-sdk-compat.mjs",
    "dev": "pnpm -r --if-present dev",
    "clean": "pnpm -r --if-present clean",
    "plugins:install": "bash scripts/install-all.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
